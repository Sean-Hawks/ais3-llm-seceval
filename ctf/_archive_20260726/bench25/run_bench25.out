                             (b\\\\\\\\\'[^\\\\\\\\\']+\\\\\\\\\')\'            
                             , content).group(1))\\\\n    return g,             
                             A, B, c, iv\\\\n\\\\ng, A, B, c, iv =              
                             parse_output(content)\\\\nprint(f\\\\\\            
